@model PostsIndexViewModel
@{
    ViewData["Title"] = "Posts";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<h1>Posts</h1>

<p>
    <a asp-controller="Posts" asp-action="Create" class="btn btn-primary">New post</a>
</p>

<form asp-controller="Posts" asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search title or body" />
    </div>
    <div class="col-auto">
        <select name="category" class="form-select">
            <option value="">All categories</option>
            @foreach (var value in Enum.GetValues<PostCategory>())
            {
                <option value="@value" selected="@(Model.Category == value)">@value</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Filter</button>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Author</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var post in Model.Posts)
        {
            <tr>
                <td><a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id">@post.Title</a></td>
                <td>@post.Category</td>
                <td>@post.Author.DisplayName</td>
                <td>
                    @if (post.AuthorId == currentUserId)
                    {
                        <a asp-controller="Posts" asp-action="Edit" asp-route-id="@post.Id">Edit</a>
                        <text> | </text>
                        <a asp-controller="Posts" asp-action="Delete" asp-route-id="@post.Id">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
