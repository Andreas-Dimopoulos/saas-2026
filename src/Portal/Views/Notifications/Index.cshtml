@model IReadOnlyList<NotificationViewModel>
@{
    ViewData["Title"] = "Notifications";
}

<h1>Notifications</h1>

<table class="table">
    <thead>
        <tr>
            <th></th>
            <th>When</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var notification in Model)
        {
            <tr class="@(notification.IsRead ? "" : "fw-bold")">
                <td>
                    @if (notification.ConversationId is not null)
                    {
                        <a asp-controller="Conversations" asp-action="Show" asp-route-id="@notification.ConversationId">@notification.Text</a>
                    }
                    else
                    {
                        @notification.Text
                    }
                </td>
                <td>@notification.CreatedAt</td>
                <td>
                    @if (!notification.IsRead)
                    {
                        <form asp-controller="Notifications" asp-action="MarkAsRead" asp-route-id="@notification.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Mark as read</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
