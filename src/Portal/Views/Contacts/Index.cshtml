@model IEnumerable<Contact>
@{
    ViewData["Title"] = "My contacts";
}

<h1>My contacts</h1>

<p>
    <a asp-controller="Contacts" asp-action="Browse" class="btn btn-primary">Add a contact</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Added</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var contact in Model)
        {
            <tr>
                <td>@contact.ContactUser.DisplayName</td>
                <td>@contact.CreatedAt.ToShortDateString()</td>
                <td>
                    <form asp-controller="Contacts" asp-action="Remove" asp-route-id="@contact.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
