@model ConversationDetailViewModel
@{
    ViewData["Title"] = Model.DisplayTitle;
}

<h1>@Model.DisplayTitle</h1>

<ul id="messageLog" class="list-group mb-3">
    @foreach (var message in Model.Messages)
    {
        <li class="list-group-item @(message.IsMine ? "list-group-item-primary" : "")">
            <div>
                <strong>@message.SenderDisplayName</strong>
                <span class="text-muted ms-2">@message.SentAt</span>
            </div>
            <div>@message.Body</div>
        </li>
    }
</ul>

<form id="sendForm" asp-controller="Conversations" asp-action="SendMessage" asp-route-id="@Model.Id" method="post" class="row g-2">
    <div class="col-auto">
        <input type="text" id="messageBody" name="Body" class="form-control" placeholder="Type a message" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Send</button>
    </div>
</form>

<p class="mt-3"><a asp-controller="Conversations" asp-action="Index">Back to messages</a></p>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>
        window.portalConversationId = @Model.Id;
        window.portalCurrentUserId = "@User.FindFirstValue(ClaimTypes.NameIdentifier)";
    </script>
    <script src="~/js/conversation.js" asp-append-version="true"></script>
}
