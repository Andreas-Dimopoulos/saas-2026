@model ConversationDetailViewModel
@{
    Layout = null;
    ViewData["Title"] = Model.DisplayTitle;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.DisplayTitle</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="p-2">
    <h5>@Model.DisplayTitle</h5>

    <ul id="messageLog" class="list-group mb-2" style="max-height: 380px; overflow-y: auto;">
        @foreach (var message in Model.Messages)
        {
            <li class="list-group-item @(message.IsMine ? "list-group-item-primary" : "")">
                <div>
                    <strong>@message.SenderDisplayName</strong>
                    <span class="text-muted ms-2">@message.SentAt</span>
                </div>
                <div>@message.Body</div>
            </li>
        }
    </ul>

    <form id="sendForm" asp-controller="Conversations" asp-action="SendMessage" asp-route-id="@Model.Id" method="post" class="d-flex gap-1">
        <input type="text" id="messageBody" name="Body" class="form-control form-control-sm" placeholder="Message" required />
        <button type="submit" class="btn btn-sm btn-primary">Send</button>
    </form>

    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>
        window.portalConversationId = @Model.Id;
        window.portalCurrentUserId = "@User.FindFirstValue(ClaimTypes.NameIdentifier)";
    </script>
    <script src="~/js/conversation.js" asp-append-version="true"></script>
</body>
</html>
