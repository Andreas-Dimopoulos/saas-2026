{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TodoContext": "Data Source=todos.db"
  },
  "Jwt": {
    "Issuer": "TodoApi",
    "Audience": "TodoApi",
    "ExpiryMinutes": 60
  }
}
